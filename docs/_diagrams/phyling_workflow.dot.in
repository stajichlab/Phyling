// Phyling module workflow. Color placeholders (words prefixed with a dollar sign) are filled per theme by docs/conf.py.
digraph phyling {
    graph [rankdir=TB, bgcolor="transparent", stylesheet="../_static/graphviz-svg.css", fontcolor="$text", fontname="Helvetica", fontsize=12, nodesep=0.4, ranksep=0.45, compound=true];
    node  [shape=box, style="rounded,filled", fillcolor="$node_fill", color="$line", fontcolor="$text", fontname="Helvetica", fontsize=11];
    edge  [color="$line", fontcolor="$text", fontname="Helvetica", fontsize=10];

    subgraph cluster_align {
        label="Align module"; style="rounded,dashed"; color="$cluster";
        InputData     [label="Input data type", shape=diamond, fillcolor="$decision_fill"];
        Translate     [label="Translate CDS to protein"];
        HMMSearch     [label="Profile HMM search via PyHMMER"];
        MSA           [label="Multiple sequence alignment\n(hmmalign / muscle)"];
        IsCDS         [label="Was input CDS?", shape=diamond, fillcolor="$decision_fill"];
        BackTranslate [label="Back-translate protein MSA to DNA"];
        OutputMSA     [label="Generate MSA (.mfa)\n& checkpoint file"];

        InputData -> Translate [label="DNA CDS"];
        InputData -> HMMSearch [label="Protein"];
        Translate -> HMMSearch;
        HMMSearch -> MSA;
        MSA -> IsCDS;
        IsCDS -> BackTranslate [label="Yes"];
        IsCDS -> OutputMSA [label="No"];
        BackTranslate -> OutputMSA;
    }

    subgraph cluster_filter {
        label="Filter module"; style="rounded,dashed"; color="$cluster";
        F1 [label="Compute treeness & RCV via PhyKIT"];
        F2 [label="Rank markers by\ntoverr = treeness / RCV"];
        F3 [label="Select top N informative markers"];
        F1 -> F2 -> F3;
    }

    subgraph cluster_tree {
        label="Tree module"; style="rounded,dashed"; color="$cluster";
        Strategy   [label="Tree strategy", shape=diamond, fillcolor="$decision_fill"];
        GeneTrees  [label="Build individual gene trees\n(FastTree)"];
        Consensus  [label="Consensus analysis\n(ASTER / ASTRAL)"];
        Concat     [label="Concatenate alignments\nto supermatrix"];
        ConcatTree [label="Infer supermatrix tree\n(FastTree / IQ-TREE / RAxML-NG)"];
        Partition  [label="Partitioned analysis\n& ModelFinder"];

        Strategy -> GeneTrees [label="default"];
        GeneTrees -> Consensus;
        Strategy -> Concat [label="-c / --concat"];
        Concat -> ConcatTree;
        ConcatTree -> Partition [label="-p / --partition"];
    }

    FinalTree [label="Final species tree\n(.nwk & figure)", fillcolor="$final_fill", color="$final_line"];

    OutputMSA -> F1;
    F3 -> Strategy;
    Consensus -> FinalTree;
    ConcatTree -> FinalTree;
    Partition -> FinalTree;
}
